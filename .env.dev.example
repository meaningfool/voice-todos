# Repo-local non-secret toggles only.
# Copy this file to `.env.dev` and uncomment what you need.

# Opt into benchmark live-smoke commands that are intentionally disabled by default.
# export BENCHMARK_ENABLE_LIVE_SMOKE=1

# Legacy opt-in flag still used by some older eval flows.
# export ITEM7_ENABLE_LIVE_SMOKE=1

# Select the browser engine used by `agent-browser`-driven smoke scripts.
# export AGENT_BROWSER_ENGINE=playwright
